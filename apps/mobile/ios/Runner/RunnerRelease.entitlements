<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 원격 알림(APNs). 서명 프로파일에 Push 가 켜져 있어야 서명된다 — App ID 에 Push 를 켜고
	     프로파일을 다시 만든 뒤에야 이 파일이 든 빌드가 서명된다. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- 결정·실패 알림을 집중 모드에서도 띄운다(interruption-level time-sensitive). App ID 에
	     Time Sensitive Notifications 를 켜고 프로파일을 다시 만들어야 서명된다. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
