{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "notification:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "murmur-runner",
          "cmd": "pnpm",
          "args": ["--filter", "@murmur/agent", "start"]
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "login-path",
          "cmd": "sh",
          "args": ["-lc", "echo $PATH"]
        }
      ]
    },
    "shell:allow-kill"
  ]
}
