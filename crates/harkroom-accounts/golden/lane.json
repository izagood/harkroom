{
  "cases": [
    {
      "name": "no-root",
      "expected": {
        "lane": {
          "pool": null,
          "accounts": []
        },
        "use": "none"
      }
    },
    {
      "name": "empty-root",
      "dirs": [
        "accounts"
      ],
      "expected": {
        "lane": {
          "pool": null,
          "accounts": []
        },
        "use": "none"
      }
    },
    {
      "name": "root-is-file",
      "files": {
        "accounts": "x"
      },
      "expected": {
        "lane": {
          "pool": null,
          "accounts": []
        },
        "use": "unreadable"
      }
    },
    {
      "name": "implicit",
      "dirs": [
        "accounts/b",
        "accounts/a",
        "accounts/Bad",
        "accounts/a_b",
        "accounts/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "accounts/.hidden"
      ],
      "files": {
        "accounts/.DS_Store": "",
        "accounts/file-x": ""
      },
      "expected": {
        "lane": {
          "pool": null,
          "accounts": [
            {
              "name": "a",
              "configDir": "<tmp>/accounts/a"
            },
            {
              "name": "b",
              "configDir": "<tmp>/accounts/b"
            }
          ]
        },
        "use": "pool"
      }
    },
    {
      "name": "implicit-order",
      "dirs": [
        "accounts/a",
        "accounts/b",
        "accounts/c"
      ],
      "env": {
        "HARKROOM_CLAUDE_ACCOUNTS": " c, a ,,a"
      },
      "expected": {
        "lane": {
          "pool": null,
          "accounts": [
            {
              "name": "c",
              "configDir": "<tmp>/accounts/c"
            },
            {
              "name": "a",
              "configDir": "<tmp>/accounts/a"
            },
            {
              "name": "a",
              "configDir": "<tmp>/accounts/a"
            }
          ]
        },
        "use": "pool"
      }
    },
    {
      "name": "implicit-order-missing",
      "dirs": [
        "accounts/a",
        "accounts/b"
      ],
      "env": {
        "HARKROOM_CLAUDE_ACCOUNTS": "a,zz,yy"
      },
      "expected": {
        "lane": {
          "error": "HARKROOM_CLAUDE_ACCOUNTS 에 없는 계정이 있다: zz, yy. <tmp>/accounts 아래에 있는 계정은 a, b 이다."
        },
        "use": "unreadable"
      }
    },
    {
      "name": "implicit-order-missing-empty",
      "dirs": [
        "accounts"
      ],
      "env": {
        "HARKROOM_CLAUDE_ACCOUNTS": "a"
      },
      "expected": {
        "lane": {
          "error": "HARKROOM_CLAUDE_ACCOUNTS 에 없는 계정이 있다: a. <tmp>/accounts 아래에 있는 계정은 (없음) 이다."
        },
        "use": "unreadable"
      }
    },
    {
      "name": "implicit-links",
      "dirs": [
        "accounts/a",
        "ext/acct"
      ],
      "files": {
        "ext/file": ""
      },
      "links": {
