                {
                  "name": "b",
                  "configDir": "<tmp>/accounts/p1/b",
                  "pool": "p1"
                },
                {
                  "name": "a",
                  "configDir": "<tmp>/accounts/p1/a",
                  "pool": "p1"
                },
                {
                  "name": "c",
                  "configDir": "<tmp>/accounts/p1/c",
                  "pool": "p1"
                }
              ]
            }
          ]
        },
